# realme GT Neo2 (bitra): re-trigger usb-moded mode composition after the
# Android container is up, so the default USB mode (mtp_adb) comes up on a
# fresh boot without a manual mode toggle. See
# /usr/libexec/bitra/usb-default-mode.sh.
[Unit]
Description=bitra: compose the default USB mode once the container is up
After=lxc-android-config.service usb-moded.service
Wants=lxc-android-config.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/bitra/usb-default-mode.sh
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
