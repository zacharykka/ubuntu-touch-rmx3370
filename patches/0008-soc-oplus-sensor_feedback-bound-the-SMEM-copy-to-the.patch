From ec807a7367591618d03e67e3c2881e89463ba93e Mon Sep 17 00:00:00 2001
From: ut-bitra <ut-bitra@localhost>
Date: Mon, 16 Nov 2026 11:28:05 +0800
Subject: [PATCH 08/13] soc: oplus: sensor_feedback: bound the SMEM copy to the
 destination size

read_data_from_share_mem() copies the firmware-reported item size into a
fixed-size struct. Clamp it so a larger item can never overflow
sensor_fb_cxt->fb_smem.
---
 .../soc/oplus/sensor/oplus_sensor_feedback/sensor_feedback.c   | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/drivers/soc/oplus/sensor/oplus_sensor_feedback/sensor_feedback.c b/drivers/soc/oplus/sensor/oplus_sensor_feedback/sensor_feedback.c
index bb3717fd2883..c8cbcc03e2dc 100755
--- a/drivers/soc/oplus/sensor/oplus_sensor_feedback/sensor_feedback.c
+++ b/drivers/soc/oplus/sensor/oplus_sensor_feedback/sensor_feedback.c
@@ -549,7 +549,8 @@ static int read_data_from_share_mem(struct sensor_fb_cxt *sensor_fb_cxt)
 		return -2;
 	}
 
-	memcpy((void *)&sensor_fb_cxt->fb_smem, (void *)fb_event, smem_size);
+	memcpy((void *)&sensor_fb_cxt->fb_smem, (void *)fb_event,
+	       min(smem_size, sizeof(sensor_fb_cxt->fb_smem)));
 	return 0;
 }
 
